# Include inside the site server. Define $backend as the FastAPI origin.
error_page 404 410 /404.html;
location = /404.html { internal; }
location = /index.html { internal; }

location = / { try_files /index.html =404; }

location = /robots.txt { proxy_pass $backend/robots.txt; }
location = /sitemap.xml { proxy_pass $backend/sitemap.xml; }

location ~* "^/places/(?<place_id>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?$" {
    proxy_pass $backend/web/places/$place_id;
    proxy_intercept_errors on;
}

location ~* ^/catalog/?$ {
    try_files /index.html =404;
}

location ~* ^/(preferences|recommendations|discovery|taste)/?$ {
    add_header X-Robots-Tag noindex always;
    try_files /index.html =404;
}

location / { try_files $uri $uri/ =404; }
