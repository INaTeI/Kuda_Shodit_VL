POSTGRES_DB=vdk_gid
POSTGRES_USER=vdk
POSTGRES_PASSWORD=local-development-change-me
DATABASE_URL=postgresql+asyncpg://vdk:local-development-change-me@db:5432/vdk_gid
ADMIN_API_KEY=replace-with-a-long-random-local-key
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_PORT=8000
FRONTEND_PORT=8080
ANALYTICS_RETENTION_DAYS=90

# Конструктор мест (/constructor/). Хеш: docker compose exec api python -m app.editor.hash_password
# Пустой EDITOR_PASSWORD_HASH отключает вход. EDITOR_COOKIE_SECURE=true — только за HTTPS.
EDITOR_USERNAME=admin
EDITOR_PASSWORD_HASH=
EDITOR_SESSION_HOURS=12
EDITOR_COOKIE_SECURE=false

# WeatherAPI.com key, server-side only
WEATHERAPI_KEY=
